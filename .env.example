# Added by Payload
# 秘密鍵は `openssl rand -hex 32` 等で生成した値を .env に設定する（実値をコミットしない。本番とは別の値にする）
PAYLOAD_SECRET=<generate-a-random-secret>
# 開発用の DB（Neon の開発用ブランチ `dev` か、手元の PostgreSQL）。本番の接続文字列はここに書かない（Vercel の Production にだけ置く）
POSTGRES_URL=postgres://postgres:<password>@127.0.0.1:5432/
# 管理画面のログイン画面の URL（/admin/<この値>）。狙われやすい /admin/login は使わず、通行証のない /admin はネタページ（/nope）になる。
# 16〜64 文字の英数字・-・_。`openssl rand -hex 16` で作り、実値をコミットしない。
# 本番（Preview 含む）で未設定だと誰も管理画面に入れない。pnpm dev は未設定なら今まで通り /admin/login
ADMIN_LOGIN_SLUG=
# true のときだけ、pnpm dev がコレクションの変更を DB の表へそのまま反映する（Payload の push）。
# 開発用の DB でだけ使う。空なら表を変えない（変更は pnpm payload migrate で当てる）
PAYLOAD_DEV_PUSH=

# メール送信（お問い合わせ（Letter）の通知、管理画面のパスワード再設定）。4つとも揃っているときだけ送る。
# 未設定でも動くが、メールは送られずログに警告が出る
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 送信元アドレス。SMTP_USER がメールアドレスでないプロバイダ（SendGrid の apikey など）のときだけ指定する。空なら SMTP_USER
SMTP_FROM=
# 通知の宛先（未設定時は SMTP_USER 宛）
CONTACT_NOTIFY_TO=

# LINE から Timeline へ投稿する webhook 用（Issue #35）
# LINE Developers コンソールの Messaging API チャネルから取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 投稿を許可する自分の LINE userId（カンマ区切りで複数可）
LINE_ALLOWED_USER_ID=
